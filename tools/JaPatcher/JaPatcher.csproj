<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows 10/11 に最初から入っている .NET Framework 4.x で動く小さな exe にする（ランタイムの同梱なし）。
       参照アセンブリはこの PC の Reference Assemblies\v4.7.1 を使い、NuGet から取ってこない。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net471</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>ArmCom2_JA</AssemblyName>
    <RootNamespace>JaPatcher</RootNamespace>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

</Project>
